# Локальный запуск. Скопируйте в .env. Рабочие ключи не записывайте.
# Платформа подставляет свои переменные до старта процесса, файл .env их не перебивает.
# .env в ZIP сабмита и в git не кладётся.

DATA_DIR=_materials

# AITUNNEL: код ходит в BASE_URL + /chat/completions, поэтому нужен корень с /v1.
# Имя модели читается из LLM_MODEL (VISION_LLM_MODEL тоже принимается).
LLM_BASE_URL=https://api.aitunnel.ru/v1
LLM_API_KEY=sk-aitunnel-bkcmjEcSd0UIoiefNmBke8bzY2LzxqRV
EMBEDDER_API_KEY=
RERANKER_API_KEY=

LLM_MODEL=gpt-6.1-terra
# Необязательно; для Terra в AITUNNEL: low, medium или high
LLM_REASONING_EFFORT=medium
EMB_MODEL=qwen3-embedding-8b
RERANKER_MODEL=rerank-5-pro

TOP_K=4
RERANKER_TOP_N=2
MAX_TOKENS=2048
MAX_WORKERS=3
TEMPERATURE=0
ANSWER_WORD_LIMIT=50
CHUNKER=headings

# Локально submission.csv удобнее в out/ (в Docker compose так же)
SUBMISSION_PATH=out/submission.csv