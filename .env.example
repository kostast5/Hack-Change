# Локальный запуск. Скопируйте в .env. Рабочие ключи не записывайте.
# Платформа подставляет свои переменные до старта процесса, файл .env их не перебивает.
# .env в ZIP сабмита и в git не кладётся.

DATA_DIR=_materials

LLM_BASE_URL=
LLM_API_KEY=
EMBEDDER_API_KEY=
RERANKER_API_KEY=

LLM_MODEL=
EMB_MODEL=
RERANKER_MODEL=

TOP_K=4
RERANKER_TOP_N=2
MAX_TOKENS=2048
MAX_WORKERS=3
TEMPERATURE=0
CHUNKER=headings
