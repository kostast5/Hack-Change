# Копия настроек команды. Можно просто переименовать в .env, если файла ещё нет.
DATA_DIR=_materials

# Корень API — с /v1 (запросы: BASE_URL + /chat/completions).
LLM_BASE_URL=https://api.aitunnel.ru/v1
LLM_API_KEY=sk-aitunnel-bkcmjEcSd0UIoiefNmBke8bzY2LzxqRV
AITUNNEL_API_KEY=sk-aitunnel-bkcmjEcSd0UIoiefNmBke8bzY2LzxqRV

LLM_MODEL=gemini-4-hydrogen
LLM_REASONING_ENABLED=0
# Если 1: low|medium|high в LLM_REASONING_EFFORT (обычно не нужно)
LLM_REASONING_EFFORT=
EMB_MODEL=qwen3-embedding-8b
RERANKER_MODEL=rerank-5-pro

TOP_K=3
RERANKER_TOP_N=1
MAX_TOKENS=2048
MAX_WORKERS=3
TEMPERATURE=0
ANSWER_WORD_LIMIT=50
CHUNKER=headings
SUBMISSION_PATH=out/submission.csv